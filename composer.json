{
    "name": "sailantis/azera-log",
    "description": "Logging companion for the Azera framework: Monolog-based logging with Azera-specific extensions (composite file rotation, console coloring) and ready-made PSR-14 listeners for database, auth, and queue events.",
    "type": "library",
    "repositories": [
        { "type": "path", "url": "../azera-framework" },
        { "type": "path", "url": "../clarity-engine" }
    ],
    "require": {
      "php": ">=8.2",
        "monolog/monolog": "^3.0",
        "sailantis/azera-framework": "dev-main",
        "psr/log": "3.0",
        "psr/event-dispatcher": "1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Azera\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azera\\Log\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
